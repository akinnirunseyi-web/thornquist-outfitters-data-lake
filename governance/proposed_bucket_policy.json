{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::thornquist-data-lake-2026102", "arn:aws:s3:::thornquist-data-lake-2026102/*"],
      "Condition": {"Bool": {"aws:SecureTransport": "false", "aws:PrincipalIsAWSService": "false"}}
    },
    {
      "Sid": "DenyAnalystAccessToNonCuratedSourceZones",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject*", "s3:PutObject*", "s3:DeleteObject*", "s3:RestoreObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::thornquist-data-lake-2026102/landing/*",
        "arn:aws:s3:::thornquist-data-lake-2026102/raw/*",
        "arn:aws:s3:::thornquist-data-lake-2026102/trusted/*",
        "arn:aws:s3:::thornquist-data-lake-2026102/quarantine/*",
        "arn:aws:s3:::thornquist-data-lake-2026102/reports/*"
      ],
      "Condition": {"ArnEquals": {"aws:PrincipalArn": "arn:aws:iam::470551642447:role/ThornquistAnalyst"}}
    },
    {
      "Sid": "DenyAnalystCuratedMutation",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:PutObject*", "s3:DeleteObject*", "s3:RestoreObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::thornquist-data-lake-2026102/curated/*",
      "Condition": {"ArnEquals": {"aws:PrincipalArn": "arn:aws:iam::470551642447:role/ThornquistAnalyst"}}
    },
    {
      "Sid": "DenyAnalystListingOutsideResultsPrefix",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::thornquist-data-lake-2026102",
      "Condition": {
        "ArnEquals": {"aws:PrincipalArn": "arn:aws:iam::470551642447:role/ThornquistAnalyst"},
        "StringNotLike": {"s3:prefix": ["athena-results/analyst", "athena-results/analyst/*"]}
      }
    }
  ]
}
